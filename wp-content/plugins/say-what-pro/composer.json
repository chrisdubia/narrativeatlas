{
    "repositories": [
        {
                "type": "vcs",
                "url": "https://github.com/leewillis77/wplisttableexportable"
            }
    ],
    "require": {
        "leewillis77/wplisttableexportable": "^0.3.4",
        "pimple/pimple": "^3.2",
        "gamajo/template-loader": "^1.3",
        "ademti/wordpress-plugin-updater": "*"
    },
    "require-dev": {
        "10up/wp_mock": "dev-trunk",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "wp-coding-standards/wpcs": "^2.3",
        "phpmd/phpmd": "^2.8"
    },
    "autoload": {
        "psr-0": {
            "": [ "src/", "src/interfaces", "tests/mocks" ]
        }
    },
    "config": {
        "platform": {
            "php": "7.3.33"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
